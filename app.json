{
  "expo": {
    "name": "Koin Expenses",
    "slug": "koin-expenses",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#F4F1EA"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Koin uses the camera to scan expense receipts."
      }
    },
    "android": {
      "permissions": ["android.permission.CAMERA"],
      "adaptiveIcon": {
        "backgroundColor": "#F4F1EA"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Koin accesses your photos so you can scan expense receipts.",
          "cameraPermission": "Koin uses your camera to scan expense receipts.",
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "45046f78-c7ca-440c-853c-bc7a438cda95"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/45046f78-c7ca-440c-853c-bc7a438cda95"
    }
  }
}
